{
  "name": "英语拼读闯关",
  "appid": "",
  "description": "外研新标准三年级词汇巩固、四上核心词起步与系统自然拼读",
  "versionName": "1.0.10",
  "versionCode": 110,
  "launch_path": "index.html",
  "app-plus": {
    "screenOrientation": [
      "portrait-primary"
    ],
    "statusbar": {
      "immersed": false,
      "style": "default",
      "background": "#a8e6ff"
    },
    "safearea": {
      "background": "#a8e6ff",
      "bottom": {
        "offset": "auto"
      }
    },
    "distribute": {
      "google": {
        "permissions": [
          "<uses-permission android:name=\"android.permission.INTERNET\"/>",
          "<uses-permission android:name=\"android.permission.ACCESS_NETWORK_STATE\"/>"
        ],
        "minSdkVersion": 21,
        "targetSdkVersion": 30,
        "abi": [
          "armeabi-v7a",
          "arm64-v8a"
        ]
      }
    }
  }
}